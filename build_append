#!/usr/bin/env bash
# Append a GGUF (plus an ELTHBLOB trailer) to a compiled executable.
#
#   build_append <model.gguf> <executable>
#
# The engine (elthur core/hosts.zig) finds the model by reading the fixed 80-byte
# trailer at the end of the running executable and mmapping the bytes recorded
# there. Appending is idempotent: if a valid trailer already exists the file is
# truncated back to its original size first, so re-running the build never stacks
# models.
#
# Trailer layout (little-endian C struct "<8sIIQQQQ32s", 80 bytes):
#   0  magic "ELTHBLOB"
#   8  u32 version (1)
#   12 u32 flags (0)
#   16 u64 model_offset
#   24 u64 model_length
#   32 u64 mapped_length (align_up(model_length, ALIGN))
#   40 u64 executable size before the model
#   48 32-byte digest (all zero = skip verification)
#
# The model is aligned to ALIGN (arm64 page size) so it stays mmap-able.
set -euo pipefail

MAGIC="ELTHBLOB"
VERSION=1
ALIGN=16384
TRAILER=80

usage() {
  cat >&2 <<'EOF'
usage: build_append <model.gguf> <executable>

Append <model.gguf> to <executable> with an elthur ELTHBLOB trailer. Idempotent:
re-running truncates any previously appended model first.
EOF
}

if [ "$#" -ne 2 ]; then
  usage
  exit 2
fi

MODEL="$1"
EXE="$2"
[ -f "$MODEL" ] || { echo "model not found: $MODEL" >&2; exit 1; }
[ -f "$EXE" ] || { echo "executable not found: $EXE" >&2; exit 1; }

# --- helpers ---------------------------------------------------------------

size_of() {
  # BSD/macOS first; fall back to wc for GNU userland.
  stat -f%z "$1" 2>/dev/null || wc -c < "$1"
}

align_up() {
  echo $(( ($1 + $2 - 1) / $2 * $2 ))
}

le32() {
  local v=$1 i oct out=""
  for i in 0 1 2 3; do
    oct="$(printf '%03o' $(( v & 255 )))"
    out="$out\\$oct"
    v=$(( v >> 8 ))
  done
  printf '%b' "$out"
}

le64() {
  local v=$1 i oct out=""
  for i in 0 1 2 3 4 5 6 7; do
    oct="$(printf '%03o' $(( v & 255 )))"
    out="$out\\$oct"
    v=$(( v >> 8 ))
  done
  printf '%b' "$out"
}

# --- idempotency: recover the pre-model size from an existing trailer ------

size="$(size_of "$EXE")"
before=""
if [ "$size" -ge "$TRAILER" ]; then
  offset=$(( size - TRAILER ))
  magic="$(tail -c "$TRAILER" "$EXE" | head -c 8)"
  if [ "$magic" = "$MAGIC" ]; then
    version="$(od -An -tu4 -j $(( offset + 8 )) -N 4 "$EXE" | tr -d ' ')"
    candidate="$(od -An -tu8 -j $(( offset + 40 )) -N 8 "$EXE" | tr -d ' ')"
    if [ "$version" = "$VERSION" ] && [ "$candidate" -gt 0 ] && [ "$candidate" -le "$size" ]; then
      before="$candidate"
    fi
  fi
fi

if [ -n "$before" ]; then
  if command -v truncate >/dev/null 2>&1; then
    truncate -s "$before" "$EXE"
  else
    tmp="$EXE.tmp.$$"
    head -c "$before" "$EXE" > "$tmp" && mv "$tmp" "$EXE"
  fi
  echo "  re-append: truncated $EXE to $before bytes"
fi

# --- append model + trailer -----------------------------------------------

size="$(size_of "$EXE")"
model_offset="$(align_up "$size" "$ALIGN")"
model_length="$(size_of "$MODEL")"
mapped_length="$(align_up "$model_length" "$ALIGN")"
pad=$(( model_offset - size ))

{
  if [ "$pad" -gt 0 ]; then
    head -c "$pad" /dev/zero
  fi
  cat "$MODEL"
  printf '%s' "$MAGIC"
  le32 "$VERSION"
  le32 0
  le64 "$model_offset"
  le64 "$model_length"
  le64 "$mapped_length"
  le64 "$size"
  head -c 32 /dev/zero
} >> "$EXE"

final="$(size_of "$EXE")"
echo "  appended $MODEL: $model_length bytes at offset $model_offset (exe $final bytes)"
